# ===== R2C.AI docker-compose environment (copy to .env and fill in) =====
# This drives `docker compose up` for local/single-host runs. Render does NOT use
# this file — set env vars per service in the dashboard (see docs/ENVIRONMENT.md).
# Host ports (change to taste; standard would be 5173/4000/55432)
FRONTEND_PORT=5174
BACKEND_PORT=4001
MATCHMAKING_PORT=8004
AI_AGENTS_PORT=8000
POSTGRES_PORT=55433
REDIS_PORT=6380

# Secrets / config
POSTGRES_PASSWORD=postgres
JWT_ACCESS_SECRET=change-me-in-production

# OpenAI — Copilot + SUTRA agents. NOTE: this account has no gpt-5.5; gpt-5.4 is the
# newest model that streams via chat/completions. SUTRA agents use a faster model.
OPENAI_API_KEY=sk-proj-your-openai-key
COPILOT_MODEL=gpt-5.4
SUTRA_OPENAI_MODEL=gpt-5-mini

# Supabase — matchmaking corpus (60 papers + pgvector). Publishable key is enough
# for matching (REST RPCs); a DB password is NOT required for the matchmaking path.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxx
