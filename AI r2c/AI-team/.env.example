# ===== SUTRA AI Agents (FastAPI) — copy to .env and fill in =====
# For Render hosting see docs/ENVIRONMENT.md and docs/RENDER_DEPLOYMENT_GUIDE.md.

# Server. On Render, bind $PORT via the Docker Command instead of SERVER_PORT
# (uvicorn app.main:app --host 0.0.0.0 --port $PORT). Set ENVIRONMENT=production.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database — Postgres with the pgvector extension (run: CREATE EXTENSION vector;).
# Render: Internal Connection String of the r2c-db-sutra instance.
DATABASE_URL=postgresql://user:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Redis (cache). Render: Internal URL of the r2c-redis Key Value instance.
REDIS_URL=redis://localhost:6379/0

# LLM Provider Selection: "openai", "gemini", "anthropic", "groq"
LLM_PROVIDER=openai

# OpenAI (Recommended). NOTE: this account has no gpt-5.5 — the 6 agents use
# gpt-5-mini for speed (gpt-5.4 is minutes/run across many calls).
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cache
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
