# ──────────────────────────────────────────────────────────────────────────
# R2C.AI — Backend environment
# Copy to `.env` and fill in. The app boots with safe defaults even if the AI
# services are not yet deployed (AI calls will return a clear "unconfigured" error).
# For Render hosting see docs/ENVIRONMENT.md and docs/RENDER_DEPLOYMENT_GUIDE.md.
# ──────────────────────────────────────────────────────────────────────────

# ── Core ──
# Postgres (Prisma). Local: docker-compose DB or a Supabase Session Pooler URL.
# Render: the Internal Connection String of the r2c-db-main Postgres instance.
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Leave PORT unset on Render (it injects $PORT). Local default is 4000.
PORT=4000
# REQUIRED on any cross-domain deploy (e.g. Render): switches the refresh cookie to
# Secure + SameSite=None so login survives token refresh across domains. Unset locally.
NODE_ENV=production
# Exact frontend origin(s), comma-separated, no trailing slash.
# Render: the static site URL, e.g. https://r2c-frontend.onrender.com
CLIENT_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
JWT_ACCESS_SECRET="change-me-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=30
# Local: ./storage. Render: /app/storage backed by an attached Disk (else uploads vanish).
STORAGE_ROOT="./storage"

# ── AI provider keys ──
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Matchmaking engine (FastAPI) ──
# Render: the matchmaking service URL, e.g. https://r2c-matchmaking.onrender.com
MATCHMAKING_API_URL="http://localhost:8004"
MATCHMAKING_API_KEY=

# ── SUTRA AI Agents (FastAPI) ──
# Render: the ai-agents service URL, e.g. https://r2c-ai-agents.onrender.com
SUTRA_AI_API_URL="http://localhost:8000"
SUTRA_AI_API_KEY=

# ── Supabase (Data API — used for direct RPC if needed) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Copilot (OpenAI direct, streaming) ──
# NOTE: this account has no gpt-5.5. gpt-5.4 is the newest model that streams via
# chat/completions; do not set gpt-5.5.
COPILOT_PROVIDER=openai
COPILOT_MODEL=gpt-5.4
COPILOT_TEMPERATURE=0.4
COPILOT_MAX_HISTORY=20

# ── Keep-alive (anti cold-start) ──
# The server self-pings its OWN PUBLIC URL + /api/v1/ping on an interval so hosts that
# sleep idle services (Render free tier ~15 min) keep resetting the idle timer. A
# localhost ping does NOT count — it must be the public URL. On Render this works with
# zero config: RENDER_EXTERNAL_URL is injected automatically. Elsewhere set KEEP_ALIVE_URL
# to your public base URL. Unset = disabled (e.g. local dev). Interval defaults to 10 min.
# KEEP_ALIVE_URL=https://r2c-backend.onrender.com
KEEP_ALIVE_MINUTES=10

# ── AI HTTP client tuning (optional) ──
AI_HTTP_TIMEOUT_MS=45000
AI_HTTP_RETRIES=2
AI_HTTP_RETRY_BASE_MS=400
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX_ENTRIES=500
