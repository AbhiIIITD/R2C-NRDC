# ---- NRDC R2C frontend (React + Vite -> static, served by nginx) ----
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Baked at build time — the browser calls the backend at this URL (host-published port).
ARG VITE_API_URL=http://localhost:4001/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- runtime ----
FROM nginx:alpine
RUN apk add --no-cache wget
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
