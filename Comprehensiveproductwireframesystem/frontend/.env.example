# ===== R2C.AI frontend (Vite) — copy to .env.local and adjust =====
# These are read at BUILD time and baked into the bundle (see src/services/api.ts).

# Local dev: leave VITE_API_URL unset — the app derives the API base from the host
# you open it on (window.location.hostname) using VITE_API_PORT. Login then works
# from localhost AND any LAN IP without per-device config.
VITE_API_PORT=4001

# Fixed/remote backend (REQUIRED for hosting, e.g. Render static site).
# Must include the /api/v1 suffix and no trailing slash. Changing it requires a rebuild.
# VITE_API_URL=https://r2c-backend.onrender.com/api/v1
