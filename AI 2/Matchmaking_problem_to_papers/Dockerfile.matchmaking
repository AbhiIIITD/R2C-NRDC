# ---- NRDC R2C matchmaking service (FastAPI + bge embeddings -> Supabase pgvector) ----
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

WORKDIR /app

# curl for healthcheck; libgomp1 required by torch (sentence-transformers)
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
# Install CPU-only torch first so sentence-transformers does NOT pull the multi-GB
# CUDA build (this service does CPU inference). Then the rest from PyPI.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install -r requirements.txt

# App code (REST mode does not need the data/ loader files)
COPY service ./service
COPY supabase ./supabase

# Pre-download the embedding model so the first request is fast (no cold download).
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-base-en-v1.5')"

EXPOSE 8004
CMD ["uvicorn", "service.main:app", "--host", "0.0.0.0", "--port", "8004"]
